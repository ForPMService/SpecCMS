# ============================================================
# SpecCMS - repository .gitignore
# Root rules for Laravel/PHP + Node/TypeScript + Windows/IDE
# Keep lock files (composer.lock, package-lock.json, pnpm-lock.yaml)
# ============================================================

# --- OS / editors ---
.DS_Store
Thumbs.db
Desktop.ini

.vs/
.idea/
.vscode/

*.suo
*.user
*.userosscache
*.sln.docstates

# Microsoft Office temporary files
~$*.docx
~$*.xlsx
~$*.pptx

# --- Logs / temporary files ---
*.log
logs/
tmp/
temp/

# --- Environment / secrets ---
**/.env
**/.env.*
!**/.env.example

# --- PHP / Composer / Laravel ---
/backend/vendor/
/backend/auth.json
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/.phpactor.json
/backend/_ide_helper.php

/backend/public/build/
/backend/public/hot
/backend/public/storage

/backend/storage/*.key
/backend/storage/pail

# Laravel also uses Node/Vite inside backend
/backend/node_modules/

# --- Node / TypeScript / frontend/editor ---
node_modules/
.npm/
.pnpm-store/
.yarn-integrity

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

coverage/
.nyc_output/
*.lcov
*.tsbuildinfo

dist/
.vite/
.cache/
.parcel-cache/

# --- Project runtime/generated CMS storage ---
# Keep directories via .gitkeep when they are created later.
/storage/assets/*
!/storage/assets/.gitkeep

/storage/artifacts/*
!/storage/artifacts/.gitkeep

/storage/exports/*
!/storage/exports/.gitkeep

# --- Misc local tooling ---
*.swp
*.swo
*~
